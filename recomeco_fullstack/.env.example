# Variáveis públicas usadas durante o build do frontend.
# SUPABASE_ANON_KEY é uma chave pública (anon/publishable), nunca use service_role no browser.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICA_SUPABASE
RECOMMENDER_API_URL=https://SUA-API-PYTHON.example.com

# Segredo do servidor: configure em Site configuration > Environment variables no Netlify.
# Não copie AI_API_KEY para js/runtime-config.js nem para o frontend.
AI_API_KEY=SUA_CHAVE_PRIVADA_DE_IA
AI_MODEL=gpt-4.1-mini
